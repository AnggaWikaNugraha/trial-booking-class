# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Midtrans sandbox (Settings -> Access Keys)
MIDTRANS_SERVER_KEY=
# Optional. Sends notifications for our transactions to this URL instead of the
# one set in the Midtrans dashboard. Use it when the dashboard URL belongs to
# another project, or when testing through a tunnel such as ngrok.
MIDTRANS_NOTIFICATION_URL=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
